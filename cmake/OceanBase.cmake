find_package(Python3 REQUIRED COMPONENTS Interpreter)
set(MEMTABLE_BENCH_OCEANBASE_CORE_DIR "${PROJECT_SOURCE_DIR}/vendor/oceanbase-keybtree"
  CACHE PATH "Verified OceanBase KeyBtree subset (generated by vendor_oceanbase.py)")
execute_process(COMMAND ${Python3_EXECUTABLE} ${PROJECT_SOURCE_DIR}/scripts/vendor_oceanbase.py
  --output ${MEMTABLE_BENCH_OCEANBASE_CORE_DIR}
  COMMAND_ERROR_IS_FATAL ANY)
add_custom_target(oceanbase_verify
  COMMAND ${Python3_EXECUTABLE} ${PROJECT_SOURCE_DIR}/scripts/vendor_oceanbase.py
    --output ${MEMTABLE_BENCH_OCEANBASE_CORE_DIR} --verify
  COMMENT "Verify pinned OceanBase sources and generated include isolation"
  VERBATIM)

add_library(memtable_oceanbase_core STATIC
  src/oceanbase_index.cc
  ${MEMTABLE_BENCH_OCEANBASE_CORE_DIR}/include/ob_tsi_utils.cpp)
add_dependencies(memtable_oceanbase_core oceanbase_verify)
target_include_directories(memtable_oceanbase_core PRIVATE include src)
target_include_directories(memtable_oceanbase_core SYSTEM PRIVATE
  ${MEMTABLE_BENCH_OCEANBASE_CORE_DIR}/include ${PROJECT_SOURCE_DIR}/vendor/oceanbase-port)
# The verified upstream headers use GNU statement expressions, typeof and
# pointer tagging. Apply their required aliasing mode only to the port target.
target_compile_options(memtable_oceanbase_core PRIVATE -fno-strict-aliasing)
set_target_properties(memtable_oceanbase_core PROPERTIES CXX_EXTENSIONS ON)
target_link_libraries(memtable_oceanbase_core PUBLIC Threads::Threads)
target_link_libraries(memtable_bench_index PRIVATE memtable_oceanbase_core)
target_compile_definitions(memtable_bench_index PRIVATE MEMTABLE_BENCH_HAVE_OCEANBASE=1)
